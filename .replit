modules = ["nodejs-24", "python-3.11", "python3", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "apitests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow]]
name = "apitests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'source /home/runner/workspace/.venv/bin/activate && cd /home/runner/workspace/artifacts/api-server && python -m pytest tests/ -q'"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/pricing-engine && pnpm exec tsc -p tsconfig.json --noEmit'"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 240000

[nix]
channel = "stable-25_05"
packages = ["cargo", "glibcLocales", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc", "xcodebuild", "yajl", "zlib"]

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8083
externalPort = 3003

[[ports]]
localPort = 18150
externalPort = 5000

[[ports]]
localPort = 18522
externalPort = 3002

[[ports]]
localPort = 19144
externalPort = 4200

[[ports]]
localPort = 23545
externalPort = 3000

[[ports]]
localPort = 25459
externalPort = 5173

[userenv]

[userenv.shared]
OWNER_ADMIN_EMAIL = "hjenner@123inkt.nl"
DISABLE_FEED_SYNC = "false"
AI_COPILOT_MODEL = "gpt-5.6-terra"

[userenv.development]
FEED_SYNC_STARTUP_DELAY = "1800"
DATA_QUALITY_SCAN_STARTUP_DELAY = "1800"
